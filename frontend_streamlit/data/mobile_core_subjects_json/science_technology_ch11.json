            {
                "heading": "Transport System in a Cell – Overview",
                "points": [
                    "Cells exchange materials through the cell membrane",
                    "Movement occurs via passive or active transport",
                    "Ensures balance of nutrients and waste removal",
                    "Essential for cell survival and function",
                    "Controlled by selective permeability of membrane"
                ]
            },
            {
                "heading": "Types of Transport in Cells",
                "points": [
                    "Passive transport: no energy required",
                    "Active transport: requires energy (ATP)",
                    "Diffusion: movement from high to low concentration",
                    "Osmosis: movement of water through semi-permeable membrane",
                    "Endocytosis and exocytosis: bulk transport processes"
                ]
            },
            {
                "heading": "Diffusion",
                "points": [
                    "Movement of molecules from high concentration to low concentration",
                    "Does not require energy",
                    "Occurs in gases and liquids",
                    "Important for gas exchange in cells",
                    "Example: oxygen entering cells"
                ]
            },
            {
                "heading": "Osmosis",
                "points": [
                    "Movement of water across a semi-permeable membrane",
                    "Water moves from dilute to concentrated solution",
                    "Requires no energy",
                    "Important for plant cell turgidity",
                    "Controls water balance in cells"
                ]
            },
            {
                "heading": "Active Transport",
                "points": [
                    "Movement of substances against concentration gradient",
                    "Requires energy (ATP)",
                    "Occurs via carrier proteins",
                    "Helps in absorption of nutrients",
                    "Example: uptake of minerals by root cells"
                ]
            },
            {
                "heading": "Endocytosis and Exocytosis",
                "points": [
                    "Endocytosis: intake of materials into the cell",
                    "Exocytosis: removal of materials from the cell",
                    "Used for large molecules",
                    "Important in immune response and secretion",
                    "Requires energy"
                ]
            },
            {
                "heading": "Transport System in Plants – Overview",
                "points": [
                    "Plants have specialized vascular tissues for transport",
                    "Xylem transports water and minerals",
                    "Phloem transports food (sugars)",
                    "Transport occurs throughout the plant body",
                    "Essential for growth and survival"
                ]
            },
            {
                "heading": "Xylem – Structure and Function",
                "points": [
                    "Transports water and minerals from roots to leaves",
                    "Made up of tracheids, vessels, xylem fibres, and parenchyma",
                    "Movement is mostly unidirectional (upward)",
                    "Provides structural support",
                    "Driven by transpiration pull"
                ]
            },
            {
                "heading": "Phloem – Structure and Function",
                "points": [
                    "Transports food (mainly sugars) from leaves to other parts",
                    "Made of sieve tubes, companion cells, and phloem fibres",
                    "Movement is bidirectional",
                    "Energy-dependent process (active transport)",
                    "Supports growth and storage"
                ]
            },
            {
                "heading": "Mechanism of Water Transport in Plants",
                "points": [
                    "Water is absorbed by root hairs from soil",
                    "Moves through xylem vessels to leaves",
                    "Transpiration creates suction force",
                    "Cohesion and adhesion help water movement",
                    "Capillary action assists transport"
                ]
            },
            {
                "heading": "Transpiration",
                "points": [
                    "Loss of water vapour from aerial parts of plants",
                    "Occurs mainly through stomata",
                    "Helps in cooling plant and water transport",
                    "Creates transpiration pull",
                    "Regulated by environmental conditions"
                ]
            },
            {
                "heading": "Food Transport in Plants (Translocation)",
                "points": [
                    "Food is transported from leaves to other parts via phloem",
                    "Occurs in both upward and downward directions",
                    "Energy required (ATP)",
                    "Known as pressure flow mechanism",
                    "Supports growth, storage, and reproduction"
                ]
            },
            {
                "heading": "Importance of Transport System",
                "points": [
                    "Ensures distribution of nutrients and water",
                    "Removes waste products",
                    "Maintains internal balance",
                    "Supports growth and metabolism",
                    "Essential for survival of organisms"
                ]
